# Get a free key at https://aistudio.google.com/apikey (use a project WITHOUT billing so a public page can't cost money)
GEMINI_API_KEY=
# Optional: models tried in order when one is busy or out of quota
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest,gemini-2.5-flash-lite
# Optional: abuse limits for the shared key
# PER_IP_PER_HOUR=150
# DAILY_CAP=1500
# Keep-awake: on Render the server pings its own /healthz (via RENDER_EXTERNAL_URL) so the free plan never sleeps.
# KEEP_AWAKE=0            # turn it off
# KEEP_AWAKE_MINUTES=10   # must stay under 15
# KEEP_AWAKE_UNTIL=2026-12-04T00:00:00+05:30   # stop pinging after this (default: end of 3 Dec IST)
# KEEP_AWAKE_IST_HOURS=8-24                    # optional night break: only ping 08:00-24:00 India time (default "" = all day)
# KEEP_AWAKE_HOURS_UNTIL=2026-12-01T00:00:00+05:30  # night break ends here; all day after (default: 1 Dec IST)
